{
  "manifest_version": 3,
  "name": "MicroLearn",
  "description": "Replaces ads with structured micro-insights.",
  "version": "3.2.5",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://api.anthropic.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "options_page": "preferences.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
