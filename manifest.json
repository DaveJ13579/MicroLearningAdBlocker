{
  "name": "MicroLearning Ad Replacer",
  "description": "Replaces ads with micro-learning content.",
  "version": "2.0",
  "manifest_version": 3,

  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],

  "options_page": "options.html",

  "web_accessible_resources": [
    {
      "resources": ["data/content.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
